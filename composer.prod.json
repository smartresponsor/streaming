{
  "name": "streaming/stream",
  "description": "Smart Responsor Streaming platform component for durable event-streaming integration.",
  "type": "symfony-bundle",
  "license": "proprietary",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.4",
    "cruding/crud": "dev-master",
    "easycorp/easyadmin-bundle": "^5.0",
    "interfacing/interface": "dev-master",
    "objecting/object": "dev-master",
    "symfony/config": "^8.1",
    "symfony/console": "^8.1",
    "symfony/dependency-injection": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/messenger": "^8.1",
    "symfony/runtime": "^8.1",
    "symfony/serializer": "^8.1",
    "symfony/yaml": "^8.1",
    "viewing/view": "dev-master"
  },
  "autoload": {
    "psr-4": {
      "App\\Streaming\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true
    },
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "^8.1",
      "bundle": "App\\Streaming\\StreamingBundle"
    }
  },
  "repositories": [
    {"type": "vcs", "url": "git@github.com:smartresponsor/cruding.git"},
    {"type": "vcs", "url": "git@github.com:smartresponsor/interfacing.git"},
    {"type": "vcs", "url": "git@github.com:smartresponsor/objecting.git"},
    {"type": "vcs", "url": "git@github.com:smartresponsor/viewing.git"}
  ]
}
