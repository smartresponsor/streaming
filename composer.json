{
  "name": "smartresponsor/streaming",
  "description": "Smart Responsor Streaming platform component for durable event-streaming integration.",
  "type": "symfony-bundle",
  "license": "proprietary",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "path",
      "url": "../Objecting",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "../Cruding",
      "options": {
        "symlink": true
      }
    }
  ],
  "require": {
    "php": "^8.4",
    "cruding/crud": "dev-master",
    "easycorp/easyadmin-bundle": "^5.0",
    "objecting/object": "dev-master",
    "symfony/framework-bundle": "^8.1",
    "symfony/messenger": "^8.1",
    "symfony/serializer": "^8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "symfony/phpunit-bridge": "^8.0"
  },
  "autoload": {
    "psr-4": {
      "App\\Streaming\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Streaming\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true
    },
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "extra": {
    "symfony": {
      "require": "^8.1"
    }
  }
}
